<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>latch_bench_mock_elect</name>
  <version>0.0.0</version>
  <description>ROS 2 process that links the in-tree mock oracle and publishes the elected mode name. Not Latch. Does not start a controller.</description>
  <maintainer email="ops@iome.sh">iome-sh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
